# Test-run environment.
#
# This file exists because it did not, and its absence was dangerous: with no
# .env.testing on disk, `php artisan migrate --env=testing` silently falls back
# to .env and runs against the real database. `migrate:fresh --env=testing`
# therefore drops production. The phpunit.xml <php> block does not protect
# against this — those variables apply only when PHPUnit itself runs, never to
# an artisan command typed by hand.
#
# Everything here points at a throwaway in-memory database and holds no real
# credentials, so it is safe to commit and safe to run destructive commands
# against. Keep it that way: never paste a live host, user or password below.

APP_NAME=RedAgos
APP_ENV=testing
APP_KEY=base64:5Cgv2pMPTGSo3WnkoCKM0rxit8Ys4DDSHd8dXyrLcdY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=array
MAIL_FROM_ADDRESS="noreply@redagos.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION_MINUTES=120
AUTH_VERIFICATION_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_THROTTLE_SECONDS=60
