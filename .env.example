APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Origin of the Nuxt SPA. Used for CORS and for the email verification and
# password reset links that are addressed to the browser application.
FRONTEND_URL=http://localhost:3000
# Comma-separated list. Defaults to FRONTEND_URL when unset.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sanctum personal access token lifetime in minutes (default: 7 days).
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# Signed email verification link lifetime in minutes.
AUTH_VERIFICATION_EXPIRE_MINUTES=60
# Password reset token lifetime in minutes, and the per-user resend cooldown in seconds.
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_THROTTLE_SECONDS=60

# Donor eligibility thresholds enforced server-side.
DONATION_MIN_AGE_YEARS=18
DONATION_MIN_WEIGHT_KG=50

# Three independent time rules. These are distinct concepts: do not collapse them.
#   interval  - minimum wait between whole-blood donations
#   screening - how long a passed preliminary screening stands
#   qr        - how long an issued check-in token can be presented
DONATION_INTERVAL_DAYS=56
DONATION_SCREENING_VALIDITY_DAYS=90
DONATION_QR_VALIDITY_DAYS=14

# Appointment booking limits.
DONATION_BOOKING_HORIZON_DAYS=90
DONATION_CANCELLATION_WINDOW_HOURS=24

# Screening questionnaire version served to donors.
DONATION_QUESTIONNAIRE_VERSION=1

# Lives potentially helped per completed donation, shown in donation history.
DONATION_LIVES_PER_DONATION=3

# Donor support contact details.
SUPPORT_HOTLINE=+63281234567
SUPPORT_HOTLINE_LABEL="(02) 8123-4567"
SUPPORT_EMAIL=support@redagos.example
SUPPORT_HOURS="Mon - Sat, 8:00 AM - 5:00 PM"

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes rendered mail to storage/logs/laravel.log and sends nothing. It
# is the default so a fresh clone works without any mail credentials.
#
# To read mail in a real client instead, use Mailtrap Email Testing (sandbox).
# Credentials are per-inbox, from Integrations -> Laravel 9+:
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<mailtrap inbox username>
#   MAIL_PASSWORD=<mailtrap inbox password>
#
# The sandbox captures mail in Mailtrap's web inbox; it never delivers to the
# real recipient. Delivering for real needs Mailtrap Email Sending
# (live.smtp.mailtrap.io:587) plus a verified sending domain, and
# MAIL_FROM_ADDRESS must then be on that domain.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
